<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Android 12 o superior siempre muestra el splash del sistema (con el ícono de la app).
         Se le pone el mismo fondo claro para que empalme con el splash animado de Compose. -->
    <style name="Theme.CampusGPS" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/fondo_splash</item>
        <item name="android:windowSplashScreenBackground">@color/fondo_splash</item>
    </style>
</resources>
